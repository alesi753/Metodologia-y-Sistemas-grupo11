# Copiá este archivo como .env y completalo. config/settings.py lo lee al arrancar;
# una variable definida en el entorno tiene prioridad sobre la del archivo.
# El .env real nunca se sube al repositorio (.gitignore).
# Los lanzadores iniciar.* lo crean solos la primera vez.

# Proveedor de IA: openrouter, anthropic o falso (sin conexión, respuestas fijas).
IA_PROVEEDOR=openrouter

# Clave de OpenRouter: https://openrouter.ai/settings/keys (empieza con sk-or-).
OPENROUTER_API_KEY=

# Modelo de OpenRouter. Por defecto los gratuitos; con saldo cargado conviene
# deepseek/deepseek-v4.1-flash.
# IA_OPENROUTER_MODELO=openrouter/free

# Anthropic, si la institución usa su propia cuenta de API.
# ANTHROPIC_API_KEY=
# IA_ANTHROPIC_MODELO=claude-sonnet-5-5

# Obligatoria en producción.
# SECRET_KEY=
