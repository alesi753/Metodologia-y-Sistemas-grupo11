classDiagram
    direction TB

    class Usuario {
        +username: str (legajo)
        +first_name: str
        +last_name: str
        +email: str
        +dni: str
        +fecha_nacimiento: date
        +groups: Group[*]
    }

    class Alumno {
        <<proxy>>
        +cursadas() Catedra[*]
        +unidad_actual(catedra) Unidad
    }

    class Profesor {
        <<proxy>>
        +catedras() Catedra[*]
    }

    class Carrera {
        +nombre: str
    }

    class Materia {
        +nombre: str
    }

    class Catedra {
        +anio: int
        +cuatrimestre: int
        +programa: JSON
        +programa_archivo: File?
    }

    class Unidad {
        +orden: int
        +titulo: str
        +conceptos: JSON
        +fecha_apertura: date?
        +fecha_limite: date
        +es_fe_de_erratas: bool
        +esta_desbloqueada(alumno) bool
    }

    class Contenido {
        +formato: Formato
        +titulo: str
        +cuerpo: JSON
        +archivo: File?
        +publicado: bool
        +es_teoria() bool
    }

    class Formato {
        <<enumeration>>
        TEXTO
        CUESTIONARIO
        PRACTICA
    }

    class Progreso {
        +completado_en: datetime?
        +intentos: int
        +respuesta: JSON
        +archivo: File?
        +en_termino() bool
    }

    class Horario {
        +dia: Dia
        +hora_inicio: time
        +hora_fin: time
    }

    class Clase {
        +numero: int
        +fecha: date
        +hora_inicio: time
        +hora_fin: time
        +titulo: str
        +resumen: str
        +link_videollamada: url?
    }

    class Asistencia {
        +registrada_en: datetime
    }

    class Evento {
        +tipo: TipoEvento
        +titulo: str
        +fecha: date
    }

    class TipoEvento {
        <<enumeration>>
        ENTREGA
        PARCIAL
        PRESENTACION
        FINAL
    }

    class Aviso {
        +titulo: str
        +cuerpo: str
        +publicado_en: datetime
    }

    Usuario <|-- Alumno
    Usuario <|-- Profesor

    Carrera "1" -- "*" Materia
    Materia "1" -- "*" Catedra
    Catedra "*" -- "*" Profesor : profesores
    Catedra "*" -- "*" Alumno : alumnos
    Catedra "1" *-- "*" Unidad
    Unidad "1" *-- "*" Contenido
    Contenido ..> Formato
    Profesor "1" -- "*" Contenido : autor
    Alumno "1" -- "*" Progreso
    Contenido "1" -- "*" Progreso
    Unidad "*" -- "*" Unidad : corrige (fe de erratas)
    Catedra "1" *-- "*" Horario
    Catedra "1" *-- "*" Clase
    Clase "*" -- "0..1" Unidad
    Clase "*" -- "*" Contenido : material y tareas
    Alumno "1" -- "*" Asistencia
    Clase "1" -- "*" Asistencia
    Catedra "1" *-- "*" Evento
    Evento ..> TipoEvento
    Evento "*" -- "0..1" Contenido : entrega
    Catedra "1" *-- "*" Aviso
    Profesor "1" -- "*" Aviso : autor
